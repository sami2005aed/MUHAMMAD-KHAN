# JWT_SECRET: Required secret for signing and verifying JWT tokens.
# AI Studio runtime reads this from environment secrets.
JWT_SECRET=""

# DELETE_PASSWORD: Required secret for Master Admin deletion confirmations.
# AI Studio runtime reads this from environment secrets.
DELETE_PASSWORD=""

# INITIAL_ADMIN_PASSWORD: Required environment secret for seeding master admin on empty Firestore (>= 10 chars).
INITIAL_ADMIN_PASSWORD=""

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# EMAIL / 2FA OTP & PASSWORD RESET CONFIGURATION
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
FROM_EMAIL="no-reply@corelinkservices.ae"

RESEND_API_KEY=""
